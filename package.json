{
  "name": "react-text",
  "version": "4.1.0",
  "description": "React translation library with plain objects as dictionaries",
  "repository": "github:franciscop/react-text",
  "author": "Francisco Presencia <public@francisco.io> (https://francisco.io/)",
  "funding": "https://www.paypal.me/franciscopresencia/19",
  "license": "MIT",
  "keywords": [
    "react",
    "translate",
    "dictionary",
    "language",
    "i18n"
  ],
  "scripts": {
    "build": "npm run build:library && npm run build:types && npm run build:prettier",
    "build:library": "vite build && mv dist/index.min.js . && rm -rf dist",
    "build:types": "dts-bundle-generator --out-file index.d.ts src/index.tsx",
    "build:prettier": "prettier --write src *.ts *.json",
    "lint": "oxlint src && tsc",
    "size": "echo $(gzip -c index.min.js | wc -c) bytes",
    "start": "vitest",
    "test": "vitest run --coverage"
  },
  "main": "index.min.js",
  "type": "module",
  "types": "index.d.ts",
  "files": [
    "index.d.ts"
  ],
  "devDependencies": {
    "@endosome/dts-bundle-generator": "9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test": "^0.28.2",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
